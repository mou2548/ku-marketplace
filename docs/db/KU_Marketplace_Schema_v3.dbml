// ==========================================
// KU MARKETPLACE - DBML SCHEMA FOR DBDIAGRAM.IO
// ==========================================


// User

Table User {
  user_id integer [pk, increment]
  email varchar(255) [unique, not null]
  first_name_en varchar(100) [not null]
  last_name_en varchar(100) [not null]
  first_name_th varchar(100) [not null]
  last_name_th varchar(100) [not null]
  avatar_url varchar(500)
  password_hash varchar(255) [not null]
  phone_number varchar(20)
  promptpay_id varchar(100)
  user_status varchar(20) [default: 'Active', note: 'Active, Suspended, Banned, Deleted']
  email_verified_at timestamp
  isAdmin boolean [default: false]
  created_at timestamp [default: `now()`]
}

Table User_Follow {
  follower_id integer [pk, not null, ref: > User.user_id]
  followed_id integer [pk, not null, ref: > User.user_id]
  created_at timestamp [default: `now()`]
  deleted_at timestamp
}

// Membership

Table Subscription {
  subscription_id integer [pk, increment]
  user_id integer [not null, ref: > User.user_id]
  tier varchar(20) [not null, note: 'Free, Silver, Gold, Diamond']
  posts_used_this_month integer [default: 0]
  subscription_status varchar(20) [default: 'Active', note: 'Active, Expired, Cancelled']
  start_date timestamp
  end_date timestamp
}

Table Subscription_Payment {
  payment_id integer [pk, increment]
  subscription_id integer [not null, ref: > Subscription.subscription_id]
  user_id integer [not null, ref: > User.user_id]
  amount "decimal(10, 2)" [not null]
  slip_image_url varchar(500) [not null]
  payment_status varchar(25) [not null, default: 'Pending', note: 'Pending, Verified, Rejected']
  rejection_reason varchar(500)
  handled_by integer [ref: > User.user_id]
  handled_at timestamp
  created_at timestamp [default: `now()`]
}

// Listings

Table Item {
  item_id integer [pk, increment]
  owner_id integer [not null, ref: > User.user_id]
  name varchar(255) [not null]
  category varchar(50) [not null, note: 'Clothing, Electronics, Home & Living, Bags, Vehicles, Sports, Stationery, Tickets, Books, Other']
  quantity integer [not null]
  condition varchar(50) [not null, note: 'New, Good, Acceptable, Poor']
  description varchar(2000)
  item_status varchar(20) [default: 'Unlisted', note: 'Unlisted, Listed, Transferred']
  course_name varchar(100)
  brand_model varchar(100)
  warranty_expiry date
  size varchar(100)
  created_at timestamp [default: `now()`]
  deleted_at timestamp
}

Table Item_Image {
  image_id integer [pk, increment]
  item_id integer [not null, ref: > Item.item_id]
  item_image_status varchar(20) [default: 'Active', note: 'Active, Inactive']
  image_url varchar(500) [not null]
  is_primary boolean [default: false]
  display_order integer [default: 0]
  created_at timestamp [default: `now()`]
}

Table Post {
  post_id integer [pk, increment]
  item_id integer [not null, ref: > Item.item_id, note: 'many posts per item (multi-listing); not unique']
  description varchar(2000)
  post_type varchar(20) [not null, note: 'SellOnly, TradeOnly, Both']
  post_status varchar(20) [default: 'Active', note: 'Active, Inactive']
  price "decimal(10,2)"
  quantity_total integer [not null, default: 1]
  quantity_remaining integer [not null, default: 1]
  wanted_item_offer varchar(500)
  created_at timestamp [default: `now()`]
  deleted_at timestamp
}

// Trading, Transaction and Appointment

Table Offer {
  offer_id integer [pk, increment]
  post_id integer [not null, ref: > Post.post_id]
  proposer_id integer [not null, ref: > User.user_id]
  additional_money "decimal(10,2)" [default: 0.00]
  offer_status varchar(20) [default: 'Pending', note: 'Pending, Accepted, Rejected, Cancelled, Withdrawn']
  created_at timestamp [default: `now()`]
}

Table Offer_Item {
  offer_id integer [not null, ref: > Offer.offer_id]
  item_id integer [not null, ref: > Item.item_id]

  indexes {
    (offer_id, item_id) [pk]
  }
}

Table Transaction {
  transaction_id integer [pk, increment]
  post_id integer [not null, ref: > Post.post_id]
  offer_id integer [ref: > Offer.offer_id]
  buyer_id integer [not null, ref: > User.user_id]
  seller_id integer [not null, ref: > User.user_id]
  quantity integer [default: 1]
  total_amount decimal(10, 2) [not null]
  transaction_status varchar(20) [default: 'Pending', note: 'Pending, Processing, Completed, Pending Refund, Cancelled, Refunded']
  delivery_method varchar(20) [not null, note: 'Meetup, Shipping']
  created_at timestamp [default: `now()`]
  item_received_confirmed_by_buyer_at timestamp
  item_received_confirmed_by_seller_at timestamp
}

Table Transaction_Shipment {
  transaction_id integer [pk, ref: - Transaction.transaction_id]
  tracking_number varchar(100)
  estimated_delivery_date date
  shipped_at timestamp
}

Table Transaction_Payment {
  payment_id integer [pk, increment]
  transaction_id integer [not null, ref: > Transaction.transaction_id]
  slip_image_url varchar(500) [not null]
  payment_status varchar(20) [default: 'Pending', note: 'Pending, Confirmed, Rejected']
  rejection_reason varchar(500)
  handled_by integer [ref: > User.user_id]
  handled_at timestamp
  created_at timestamp [default: `now()`]
}

Table Transaction_Cancellation {
  cancellation_id integer [pk, increment]
  transaction_id integer [not null, ref: > Transaction.transaction_id]
  requested_by integer [not null, ref: > User.user_id]
  reason varchar(500)
  requested_at timestamp [default: `now()`]
  response varchar(20) [default: 'Pending', note: 'Pending, Approved, Rejected']
  responded_at timestamp
}

Table Transaction_Refund {
  transaction_id integer [pk, ref: - Transaction.transaction_id]
  item_return_confirmed_at timestamp
  created_at timestamp [default: `now()`]
}

Table Transaction_Refund_Slip {
  refund_slip_id integer [pk, increment]
  transaction_id integer [not null, ref: > Transaction_Refund.transaction_id]
  refund_slip_url varchar(500) [not null]
  refund_status varchar(20) [default: 'Pending', note: 'Pending, Confirmed, Rejected']
  rejection_reason varchar(500)
  handled_at timestamp
  created_at timestamp [default: `now()`]
}

Table Appointment_Card {
  appointment_id integer [pk, increment]
  transaction_id integer [not null, ref: > Transaction.transaction_id]
  proposed_by integer [not null, ref: > User.user_id]
  date date [not null]
  time time [not null]
  location varchar(255) [not null]
  appointment_status varchar(20) [default: 'Pending', note: 'Pending, Confirmed, Rejected']
  created_at timestamp [default: `now()`]
  deleted_at timestamp
}

// Moderation

Table Report {
  report_id integer [pk, increment]
  reporter_id integer [not null, ref: > User.user_id]
  report_type varchar(20) [not null, note: 'Post, User, Transaction']
  sanction varchar(30) [note: 'none, warn, suspend_temporary, suspend_permanent']
  target_id integer [not null]
  reason_category varchar(100) [not null]
  details varchar(2000)
  evidence_urls jsonb
  report_status varchar(20) [default: 'Pending', note: 'Pending, Under_Investigation, Violation_Confirmed, Report_Dismissed']
  handled_by integer [ref: > User.user_id]
  resolution_note varchar(1000)
  handled_at timestamp
  created_at timestamp [default: `now()`]
}

Table Appeal {
  appeal_id integer [pk, increment]
  report_id integer [not null, ref: > Report.report_id]
  appellant_id integer [not null, ref: > User.user_id]
  reason varchar(2000) [not null]
  evidence_urls jsonb
  appeal_status varchar(20) [not null, note: 'Pending, Under_Review, Approved, Rejected']
  handled_by integer [ref: > User.user_id]
  resolution_note varchar(1000)
  created_at timestamp [default: `now()`]
  handled_at timestamp
}

// Giveaway

Table Giveaway_Post {
  giveaway_id integer [pk, increment]
  item_id integer [ref: > Item.item_id, not null]
  quantity integer [not null, default: 1]
  description varchar(2000)
  pickup_location varchar(255) [not null]
  giver_id integer [not null, ref: > User.user_id]
  allocation_method varchar(20) [not null, note: 'FirstCome, Random, Manual']
  giveaway_status varchar(20) [default: 'Active', note: 'Active, Closed, Completed']
  register_start timestamp
  register_deadline timestamp
  pickup_start timestamp
  pickup_deadline timestamp
  drawn_at timestamp
  created_at timestamp [default: `now()`]
}

Table Giveaway_Ticket {
  ticket_id integer [pk, increment]
  giveaway_id integer [not null, ref: > Giveaway_Post.giveaway_id]
  receiver_id integer [not null, ref: > User.user_id]
  queue_number integer [not null]
  qr_token varchar(255) [unique]
  ticket_status varchar(20) [default: 'Waiting', note: 'Registered, Waiting, NotSelected, Received, Forfeited, Expired']
  qr_issued_at timestamp
  updated_at timestamp [default: `now()`]

  indexes {
    (giveaway_id, queue_number) [unique]
  }
}

Table Giveaway_Image {
  image_id integer [pk, increment]
  giveaway_id integer [not null, ref: > Giveaway_Post.giveaway_id]
  image_status varchar(20) [default: 'Active', note: 'Active, Inactive']
  image_url varchar(500) [not null]
  display_order integer [default: 0]
  created_at timestamp [default: `now()`]
}

// Chat

Table Chat_Room {
  room_id integer [pk, increment]
  transaction_id integer [ref: > Transaction.transaction_id]
  giveaway_id integer [ref: > Giveaway_Post.giveaway_id]
  chat_room_status varchar(20) [default: 'Active', note: 'Active, Inactive']
  created_at timestamp [default: `now()`]
}

Table Chat_Message {
  message_id integer [pk, increment]
  room_id integer [not null, ref: > Chat_Room.room_id]
  sender_id integer [not null, ref: > User.user_id]
  content varchar(2000)
  image_urls jsonb
  created_at timestamp [default: `now()`]
}

// Notification
Table Notification {
  notification_id integer [pk, increment]
  user_id integer [not null, ref: > User.user_id]
  event_key varchar(255) [not null]
  title varchar(255) [not null]
  body varchar(1000) [not null]
  href varchar(500) [not null]
  created_at timestamp [default: `now()`]
  read_at timestamp

  indexes {
    (user_id, event_key) [unique]
  }
}
