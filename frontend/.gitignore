# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# QR decoder binary, copied from node_modules by scripts/copy-zxing-wasm.mjs
/public/zxing/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent / assistant config — never commit
.claude/
.cursor/

# local design sources (large binaries, kept off the repo)
/picforgen
color.png
/UI_Marketplace (1)

# UX/UI revision pass (2026) — working documents, deliberately kept local.
# See docs/UX-REVISION-PLAN.md. None of these are committed.
/PRODUCT.md
/DESIGN.md
/.impeccable/
/docs/UX-REVISION-PLAN.md
/docs/ux/research-2026.md
/docs/ux/owner-interview.md
/docs/design/register.md
/docs/design/audit-2026.md
/docs/design/revision-brief.md
/docs/design/review-2026.md
