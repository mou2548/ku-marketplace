model Transaction {
  transaction_id                                   Int                @id @default(autoincrement())
  post_id                                          Int
  offer_id                                         Int?
  buyer_id                                         Int
  seller_id                                        Int
  quantity                                         Int?               @default(1)
  transaction_status                               String?            @default("Pending") @db.VarChar(20)
  active_report_id                                 Int?
  delivery_method                                  String             @db.VarChar(20)
  slip_image_url                                   String?            @db.VarChar(500)
  tracking_number                                  String?            @db.VarChar(100)
  estimated_delivery_date                          DateTime?          @db.Date
  payment_confirmed_by_buyer_at                    DateTime?          @db.Timestamp(6)
  payment_confirmed_by_seller_at                   DateTime?          @db.Timestamp(6)
  item_received_confirmed_by_buyer_at              DateTime?          @db.Timestamp(6)
  item_received_confirmed_by_seller_at             DateTime?          @db.Timestamp(6)
  item_return_confirmed_at                         DateTime?          @db.Timestamp(6)
  cancellation_requested_by                        Int?
  cancellation_reason                              String?
  cancellation_requested_at                        DateTime?          @db.Timestamp(6)
