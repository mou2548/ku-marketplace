// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- §4.1 User ---
// Same shape as feature/backend-reportandappeal (report/appeal relations
// included below) so the two branches' schemas merge cleanly later.
model User {
  user_id       Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(255)
  first_name_en String   @db.VarChar(100)
  last_name_en  String   @db.VarChar(100)
  first_name_th String   @db.VarChar(100)
  last_name_th  String   @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  phone_number  String?  @db.VarChar(20)
  status        String   @default("Active") @db.VarChar(20)
  isAdmin       Boolean  @default(false)
  created_at    DateTime @default(now())

  reports_filed   Report[] @relation("ReportReporter")
  reports_handled Report[] @relation("ReportHandledBy")
  appeals_filed   Appeal[] @relation("AppealAppellant")
  appeals_handled Appeal[] @relation("AppealHandledBy")

  items_owned            Item[]
  offers_proposed        Offer[]
  transactions_as_buyer  Transaction[] @relation("TransactionBuyer")
  transactions_as_seller Transaction[] @relation("TransactionSeller")
}

// --- §4.9 Report / Appeal (carried over from feature/backend-reportandappeal
// so this branch's migration doesn't drop tables that branch already created) ---
enum ReportType {
  Post
  User
  Transaction
}

enum ReportStatus {
  Pending
  Under_Investigation
  Violation_Confirmed
  Report_Dismissed
}

model Report {
  report_id       Int          @id @default(autoincrement())
  reporter_id     Int
  reporter        User         @relation("ReportReporter", fields: [reporter_id], references: [user_id])
  report_type     ReportType
  target_id       Int
  reason_category String       @db.VarChar(100)
  details         String?
  evidence_urls   Json?
  status          ReportStatus @default(Pending)
  handled_by      Int?
  handler         User?        @relation("ReportHandledBy", fields: [handled_by], references: [user_id])
  resolution_note String?
  handled_at      DateTime?
  created_at      DateTime     @default(now())

  appeals      Appeal[]
  transactions Transaction[]
}

enum AppealStatus {
  Pending
  Under_Review
  Approved
  Rejected
}

model Appeal {
  appeal_id       Int          @id @default(autoincrement())
  report_id       Int
  report          Report       @relation(fields: [report_id], references: [report_id])
  appellant_id    Int
  appellant       User         @relation("AppealAppellant", fields: [appellant_id], references: [user_id])
  reason          String
  evidence_urls   Json?
  status          AppealStatus @default(Pending)
  handled_by      Int?
  handler         User?        @relation("AppealHandledBy", fields: [handled_by], references: [user_id])
  resolution_note String?
  created_at      DateTime     @default(now())
  handled_at      DateTime?
}

// --- §4.2 Item ---
enum ItemCategory {
  Books
  Electronics
  Fashion
  Stationery
  DormSupplies
  Sports
  SpecializedEquipment
  Vehicles
  EventTickets
  Other
}

enum ItemCondition {
  New
  Very_Good
  Good
  Acceptable
}

enum ItemStatus {
  Unlisted
  Listed
  Transferred
}

model Item {
  item_id  Int    @id @default(autoincrement())
  owner_id Int
  owner    User   @relation(fields: [owner_id], references: [user_id])
  name     String @db.VarChar(255)

  category    ItemCategory
  condition   ItemCondition
  description String?
  status      ItemStatus    @default(Unlisted)

  // §10 open issue #4: NOT NULL in the doc but only required for the Books
  // category at the application layer — must stay nullable at the DB level.
  course_name     String?   @db.VarChar(100)
  brand_model     String?   @db.VarChar(100)
  warranty_expiry DateTime? @db.Date
  size            String?   @db.VarChar(20)

  created_at DateTime @default(now())

  posts       Post[]
  offer_items OfferItem[]
}

// --- §4.4 Post ---
enum PostType {
  SellOnly
  TradeOnly
  Both
}

model Post {
  post_id Int @id @default(autoincrement())

  // §10 open issue #3: not @unique — a lifetime-unique item_id would block
  // re-listing an item after it's unlisted. "One active post per item" is
  // enforced at the application layer instead.
  item_id Int
  item    Item @relation(fields: [item_id], references: [item_id])

  post_type          PostType
  price              Decimal  @db.Decimal(10, 2)
  quantity_total     Int      @default(1)
  quantity_remaining Int      @default(1)
  created_at         DateTime @default(now())

  offers       Offer[]
  transactions Transaction[]
}

// --- §4.5 Offer / Offer_Item ---
enum OfferStatus {
  Pending
  Accepted
  Rejected
  Cancelled
  Withdrawn
}

model Offer {
  offer_id         Int         @id @default(autoincrement())
  post_id          Int
  post             Post        @relation(fields: [post_id], references: [post_id])
  proposer_id      Int
  proposer         User        @relation(fields: [proposer_id], references: [user_id])
  additional_money Decimal     @default(0.00) @db.Decimal(10, 2)
  status           OfferStatus @default(Pending)
  created_at       DateTime    @default(now())

  offer_items  OfferItem[]
  transactions Transaction[]
}

model OfferItem {
  offer_id Int
  offer    Offer @relation(fields: [offer_id], references: [offer_id])
  item_id  Int
  item     Item  @relation(fields: [item_id], references: [item_id])

  @@id([offer_id, item_id])
  @@map("Offer_Item")
}

// --- §4.6 / §7.4 / §8.3 / §8.6 / §8.7 Transaction ---
enum TransactionStatus {
  Pending
  Processing
  Completed
  Cancelled
}

enum DeliveryMethod {
  Meetup
  Shipping
}

model Transaction {
  transaction_id Int  @id @default(autoincrement())
  post_id        Int
  post           Post @relation(fields: [post_id], references: [post_id])

  // NULL when bought outright (no offer/trade involved) — §4.6
  offer_id Int?
  offer    Offer? @relation(fields: [offer_id], references: [offer_id])

  buyer_id  Int
  buyer     User @relation("TransactionBuyer", fields: [buyer_id], references: [user_id])
  seller_id Int
  seller    User @relation("TransactionSeller", fields: [seller_id], references: [user_id])

  quantity Int               @default(1)
  status   TransactionStatus @default(Pending)

  // Dispute status is a parallel dimension (§8.4) — now a real FK since the
  // Report model lives in this schema too.
  active_report_id Int?
  active_report    Report? @relation(fields: [active_report_id], references: [report_id])

  delivery_method               DeliveryMethod
  slip_image_url                String?        @db.VarChar(500)
  tracking_number               String?        @db.VarChar(100)
  estimated_delivery_date       DateTime?      @db.Date
  payment_confirmed_by_buyer_at DateTime?

  // Not in the §4.6 table as written, but required to implement the §8.6
  // state machine: Completed needs BOTH "seller confirmed payment received"
  // AND "buyer confirmed delivery received" as independent conditions —
  // one buyer-side timestamp alone can't represent both.
  payment_received_by_seller_at  DateTime?
  delivery_confirmed_by_buyer_at DateTime?

  // §8.7 cancel-request flow during Processing
  cancel_requested_by Int?
  cancel_requested_at DateTime?

  // §10 open issue #2: evidence-tracking only, per the payment philosophy —
  // recording that the two parties refunded each other off-platform, not a
  // real money-moving action or a new transaction status.
  refund_slip_url     String?   @db.VarChar(500)
  refund_confirmed_at DateTime?

  created_at DateTime @default(now())
}
