generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Appeal {
  appeal_id                      Int       @id @default(autoincrement())
  report_id                      Int
  appellant_id                   Int
  reason                         String
  evidence_urls                  Json?
  appeal_status                  String    @db.VarChar(20)
  handled_by                     Int?
  resolution_note                String?
  created_at                     DateTime? @default(now()) @db.Timestamp(6)
  handled_at                     DateTime? @db.Timestamp(6)
  User_Appeal_appellant_idToUser User      @relation("Appeal_appellant_idToUser", fields: [appellant_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  User_Appeal_handled_byToUser   User?     @relation("Appeal_handled_byToUser", fields: [handled_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  Report                         Report    @relation(fields: [report_id], references: [report_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Appointment_Card {
  appointment_id     Int         @id @default(autoincrement())
  transaction_id     Int
  proposed_by        Int
  date               DateTime    @db.Date
  time               DateTime    @db.Time(6)
  location           String      @db.VarChar(255)
  appointment_status String?     @default("Pending") @db.VarChar(20)
  created_at         DateTime?   @default(now()) @db.Timestamp(6)
  User               User        @relation(fields: [proposed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  Transaction        Transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Chat_Message {
  message_id Int       @id @default(autoincrement())
  room_id    Int
  sender_id  Int
  content    String?
  image_urls Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  Chat_Room  Chat_Room @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)
  User       User      @relation(fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Chat_Room {
  room_id          Int            @id @default(autoincrement())
  transaction_id   Int?
  giveaway_id      Int?
  chat_room_status String?        @default("Active") @db.VarChar(20)
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  Chat_Message     Chat_Message[]
  Giveaway_Post    Giveaway_Post? @relation(fields: [giveaway_id], references: [giveaway_id], onDelete: NoAction, onUpdate: NoAction)
  Transaction      Transaction?   @relation(fields: [transaction_id], references: [transaction_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Giveaway_Image {
  image_id      Int           @id @default(autoincrement())
  giveaway_id   Int
  image_status  String?       @default("Active") @db.VarChar(20)
  image_url     String        @db.VarChar(500)
  display_order Int?          @default(0)
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  Giveaway_Post Giveaway_Post @relation(fields: [giveaway_id], references: [giveaway_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Giveaway_Post {
