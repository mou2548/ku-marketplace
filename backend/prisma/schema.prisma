  Offer                                            Offer?             @relation(fields: [offer_id], references: [offer_id], onDelete: NoAction, onUpdate: NoAction)
  Post                                             Post               @relation(fields: [post_id], references: [post_id], onDelete: NoAction, onUpdate: NoAction)
  User_Transaction_seller_idToUser                 User               @relation("Transaction_seller_idToUser", fields: [seller_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
