model Offer {
  offer_id         Int           @id @default(autoincrement())
  post_id          Int
  proposer_id      Int
  additional_money Decimal?      @default(0.00) @db.Decimal(10, 2)
  offer_status     String?       @default("Pending") @db.VarChar(20)
  created_at       DateTime?     @default(now()) @db.Timestamp(6)
  Post             Post          @relation(fields: [post_id], references: [post_id], onDelete: NoAction, onUpdate: NoAction)
  User             User          @relation(fields: [proposer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  Offer_Item       Offer_Item[]
